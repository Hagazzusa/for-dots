[gd_resource type="Resource" load_steps=2 format=3]
[ext_resource type="Script" path="res://config/story_text.gd" id="1"]
[resource]
script = ExtResource("1")
title = "08번 · 밤의 노선도"
pages = Array[String](["이 정류장 → 시장길 → 강변 → 종점\n\n시장길에는 문 닫은 가게들이 줄지어 있고,\n강변에서는 창밖으로 다리의 불빛이 보인다고 한다.", "종점에서 내려 골목 하나를 지나면 집이다.\n오늘은 서두를 일이 없다. 이번 차를 타도, 다음 차를 타도.\n\n※ 이 노선은 이 작은 게임 속의 가상 노선입니다."])
