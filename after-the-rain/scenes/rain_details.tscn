[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/rain_details.gd" id="Script"]
[sub_resource type="Shader" id="RingShader"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, depth_draw_never, shadows_disabled;\nuniform float phase = 0.0;\nuniform float opacity = 0.16;\nuniform vec2 center = vec2(0.0);\nvoid fragment(){\n vec2 p=(UV-vec2(0.5))*2.0-center;\n float radius=mix(0.06,0.78,phase);\n float ring=1.0-smoothstep(0.008,0.018,abs(length(p)-radius));\n float fade=smoothstep(0.0,0.08,phase)*(1.0-phase)*(1.0-phase);\n ALBEDO=vec3(0.47,0.58,0.62);\n ALPHA=ring*fade*opacity;\n}"
