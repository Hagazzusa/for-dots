extends SceneTree
func _initialize():call_deferred("run")
func run():
 var game=load("res://main.tscn").instantiate()
 root.add_child(game);game.set_process(false);game.player.set_physics_process(false);game.player.input_enabled=false
 game.restart()
 assert(game.bus.countdown_seconds()==75 and game.clock.time_text()=="23:40")
 game.wait_quietly()
 assert(game.bus.phase=="waiting" and game.clock.elapsed==0)
 game.player.sit(game.world.anchor("Seat"))
 game.drink.request_action(true,false);game.drink.advance(1.5)
 game.drink.request_action(false,false)
 var sip=game.drink.sip_time
 game.story.panel.open_story(game.story.stories["Memo"])
 game.bus.advance(4.25);game.clock.advance(4.25)
 game.wait_quietly()
 assert(game.bus.phase=="approaching" and game.bus.phase_time==0)
 assert(is_equal_approx(game.clock.elapsed,67) and game.clock.time_text()=="23:41")
 assert(game.drink.sip_time==sip and game.story.panel.is_open)
 game.wait_quietly()
 assert(is_equal_approx(game.clock.elapsed,67))
 game.restart()
 game.umbrella.borrow();game.exploration.borrowed=true
 assert(game.exchange.request_offer())
 game.story.panel.select_choice(0)
 assert(game.exchange.loaned and not game.umbrella.held)
 assert(not game.exploration.basket_available())
 var point=game.exploration.basket.global_position
 game.player.global_position=point+Vector3(0,0,1)
 game.player.camera.look_at(point)
 assert(game.exploration.try_interact(game.player.camera,game.player.global_position))
 assert(not game.umbrella.held)
 game.story.panel.close_story()
 game.bus.advance(game.bus.effective_wait_seconds());game.bus.advance(8)
 game.board_bus()
 assert(game.boarded and game.ride_note==game.exchange.boarding_caption(false))
 assert(game.ride_note!=game.exchange.boarding_caption(true))
 assert(not game.exchange.loan_prop.visible)
 game.restart()
 assert(not game.exchange.loaned and game.exploration.basket_available() and game.clock.elapsed==0)
 game.umbrella.borrow();assert(game.exchange.request_offer());game.story.panel.select_choice(0);game.story.panel.close_story()
 var passenger=game.story.objects.get_node("Passenger")
 game.bus.advance(game.bus.effective_wait_seconds());game.bus.advance(8)
 for i in range(150):
  game.bus.advance(.1)
  game.story.advance_passenger(.1,game.bus.phase,game.world.anchor("Boarding")+Vector3(0,0,.65))
  game.exchange.present(.1,game.bus.phase)
 assert(passenger.state=="boarded" and game.bus.phase=="stopped")
 game.board_bus()
 assert(game.ride_note==game.exchange.boarding_caption(true) and not game.exchange.loan_prop.visible)
 game.restart()
 game.umbrella.borrow();assert(game.exchange.request_offer());game.story.panel.select_choice(0);game.story.panel.close_story()
 passenger.leave_with_player()
 game.exchange.present(0,"departing")
 assert(game.exchange.departed)
 game.bus.advance(game.bus.effective_wait_seconds());game.bus.advance(8)
 game.board_bus()
 assert(game.ride_note==game.exchange.boarding_caption(false))
 game.restart()
 assert(game.bus.countdown_seconds()==75 and not game.exchange.departed and game.ride_note.is_empty())
 for n in game.find_children("*","",true,false):
  if n is AudioStreamPlayer or n is AudioStreamPlayer3D:n.stop();n.stream=null
 await create_timer(.2).timeout
 game.free();await create_timer(.3).timeout
 print("EVENING INTEGRATION PASS: exact seated skip, unchanged sip/reader, loan basket uniqueness, later-bus memory, reset")
 quit()
