extends SceneTree
func _initialize(): call_deferred("run")
func run():
	var scene = load("res://scenes/ambience.tscn")
	var count = AudioServer.bus_count
	var a = scene.instantiate()
	var b = scene.instantiate()
	root.add_child(a)
	root.add_child(b)
	assert(AudioServer.bus_count == count)
	assert(a.canopy_player.stream != b.canopy_player.stream)
	assert(a.canopy_player.stream.loop_mode == AudioStreamWAV.LOOP_FORWARD)
	assert(a.canopy_player.stream.loop_end == 132300)
	a.advance(1,false,false,"waiting")
	assert(a.rain_filter.cutoff_hz == 12000 and a.rain_player.volume_db == -11)
	assert(a.canopy_player.volume_db == -80)
	a.advance(1,false,false,"approaching",true)
	assert(a.rain_filter.cutoff_hz == 4200 and a.rain_player.volume_db == -14)
	assert(a.canopy_player.volume_db == -27 and a.engine_player.volume_db == -29)
	assert(b.canopy_player.volume_db == -80 and b.rain_player.volume_db == -11)
	assert(a.rain_filter == b.rain_filter) # documented one shared project mix
	a.advance(1,true,false,"stopped",true)
	assert(a.rain_filter.cutoff_hz == 1700 and a.rain_player.volume_db == -18)
	assert(a.canopy_player.volume_db == -80)
	a.advance(1,false,true,"stopped",true)
	assert(a.rain_player.volume_db == -23 and a.canopy_player.volume_db == -80)
	a.advance(1,false,false,"waiting",false)
	assert(a.rain_filter.cutoff_hz == 12000 and a.rain_player.volume_db == -11)
	a.start()
	assert(a.canopy_player.playing and a.rain_player.playing)
	a.footsteps(.01,true,false)
	assert(a.wet_footsteps.playing and not a.roof_footsteps.playing)
	assert(is_equal_approx(a._step_time,.45))
	a.footsteps(.1,true,true)
	assert(not a.roof_footsteps.playing)
	a.footsteps(.4,true,true)
	assert(a.roof_footsteps.playing)
	AudioServer.set_bus_mute(0,true)
	a.reset()
	assert(AudioServer.is_bus_mute(0))
	assert(a._step_time == 0 and not a.wet_footsteps.playing and not a.roof_footsteps.playing)
	assert(a.canopy_player.volume_db == -80 and a.rain_filter.cutoff_hz == 12000)
	a.stop_all()
	for child in a.get_children():
		assert(not child.playing)
	a.start()
	assert(a.canopy_player.playing)
	a.toggle_mute()
	assert(not AudioServer.is_bus_mute(0))
	a.stop_all()
	for child in a.get_children():
		child.stream = null
	await create_timer(.5).timeout
	a.queue_free()
	b.queue_free()
	await process_frame
	assert(AudioServer.bus_count == count)
	print("V7 AMBIENCE PASS: backward-compatible mix; canopy/roof/boarded priority; private looping streams; footsteps cadence; mute preserved; reset/stop/restart; fixed bus count")
	quit()
