extends Node
func run(s:Node):
	s.set_process(false)
	s.player.position=s.world.anchor("Stand")
	s.player.camera.look_at(s.world.anchor("Seat")) # Explicitly face bench, not a new optional prop.
	s.interact()
	assert(s.player.seated)
	s.drink_action()
	assert(s.drink.sips==0)
	s.interact()
	s.player.position=s.world.anchor("Vending")
	s.drink_action()
	s.drink_action()
	assert(s.drink.dispensing>0 and s.drink.sips==0)
	s.drink.advance(1.5)
	assert(s.drink.sips==3 and s.drink.has_cup)
	s.player.position=s.world.anchor("Stand")
	s.player.camera.look_at(s.world.anchor("Seat")) # Explicitly face bench, not a new optional prop.
	s.interact()
	for n in range(3):
		s.drink_action()
		s.drink_action()
		assert(s.drink.sips==2-n)
		s.drink.advance(1.5)
	assert(s.drink.has_cup and s.drink.sips==0)
	s.interact()
	s.player.global_position=s.disposal_point.global_position
	s.interact()
	assert(not s.drink.has_cup)
	s.interact()
	assert(not s.drink.has_cup)
	s.player.position=s.world.anchor("Vending")
	s.drink_action()
	s.drink.advance(1.5)
	assert(s.drink.sips==3)
	assert(not s.drink.dispose_empty())
	s.restart()
	assert(not s.player.seated and not s.boarded and not s.drink.has_cup)
	s.bus.advance(26)
	assert(s.bus.phase=="approaching")
	s.bus.advance(9)
	assert(s.bus.phase=="stopped")
	s.player.position=s.world.anchor("Vending")
	s.drink_action()
	s.drink.advance(1.5)
	s.player.position=s.world.anchor("Boarding")
	s.interact()
	assert(s.boarded and s.drink.has_cup and not s.ride_finished)
	s.onboard.advance(9)
	assert(s.ride_finished)
	s.restart()
	assert(not s.onboard.visible and s.player.camera.current and not s.ride_finished)
	s.bus.advance(26)
	s.bus.advance(9)
	s.player.position=s.world.anchor("Boarding")
	s.interact()
	s.onboard.advance(2)
	s.restart()
	assert(not s.boarded and not s.ride_finished)
	s.bus.advance(26)
	s.bus.advance(9)
	s.bus.advance(21)
	assert(s.bus.phase=="departing")
	s.bus.advance(9)
	assert(s.bus.phase=="waiting")
	var cup=s.player.held_drink.cup
	cup.set_fill(1,true)
	for up in [Vector3.UP,Vector3(.6,.8,0),Vector3(-.6,.8,.5),Vector3(1,.01,1)]:
		for i in range(20):
			cup.impulse(Vector2(.2,-.2))
			cup.update_liquid(1.0/60,up)
		assert(cup.max_surface_height<=.076)
	cup.set_fill(0,true)
	assert(cup.current_fill==0)
	s.restart()
	await get_tree().create_timer(.4).timeout
	assert(s.player.position.y>.5)
	assert(s.player.interaction_requested.get_connections().size()==1)
	assert(AudioServer.bus_count==2)
	print("V4 GAMEPLAY PASS: baseline + disposal, board with cup, ride ending/reset; signals, bounds, fixed audio layout")
