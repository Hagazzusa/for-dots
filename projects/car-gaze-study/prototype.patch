diff --git a/after-the-rain/scripts/neighborhood_extension.gd b/after-the-rain/scripts/neighborhood_extension.gd
index d48b45f..c4b51a3 100644
--- a/after-the-rain/scripts/neighborhood_extension.gd
+++ b/after-the-rain/scripts/neighborhood_extension.gd
@@ -62,6 +62,13 @@ func advance(delta:float)->void:
  if shutting_down or not enabled or not is_finite(delta):return
  if heater.stream and not heater.playing:heater.play()
  elapsed+=maxf(delta,0.0)
+ # Isolated visibility prototype: short head turn, driven by existing local elapsed.
+ var phase:=fmod(elapsed,24.0)
+ var turn:=0.0
+ if phase>=18.0 and phase<19.2:turn=smoothstep(18.0,19.2,phase)
+ elif phase>=19.2 and phase<20.2:turn=1.0
+ elif phase>=20.2 and phase<21.4:turn=1.0-smoothstep(20.2,21.4,phase)
+ $ParkedCar/Driver/HeadPivot.rotation.y=deg_to_rad(-25.0)*turn
  # Tiny seated breathing, not conversation, driving or a new occupant.
  $ParkedCar/Driver.position.y=sin(elapsed*1.05)*0.003
  $ParkedCar/Passenger.position.y=sin(elapsed*0.92+0.8)*0.003
@@ -71,6 +78,7 @@ func set_active(value:bool)->void:
 func reset()->void:
  if shutting_down:return
  elapsed=0.0
+ $ParkedCar/Driver/HeadPivot.rotation.y=0.0
  enabled=true
  $ParkedCar/Driver.position.y=0
  $ParkedCar/Passenger.position.y=0
