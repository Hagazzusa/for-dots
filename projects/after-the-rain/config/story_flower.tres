[gd_resource type="Resource" load_steps=2 format=3]
[ext_resource type="Script" path="res://config/story_text.gd" id="1"]
[resource]
script = ExtResource("1")
title = "문 닫은 꽃집"
pages = Array[String](["오늘은 쉽니다. 예약 꽃 찾으실 분께: 늦어도 괜찮아요. 앞쪽 불은 켜 둘게요.", "포장을 마친 꽃다발 하나가 물통에 꽂혀 있다. 주인은 포장지 윗부분을 한 번 정리하고, 잠시 창가를 바라본다."])
