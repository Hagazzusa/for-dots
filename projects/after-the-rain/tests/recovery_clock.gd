extends SceneTree
var checks := 0
var arrivals := 0
func check(value: bool, message: String) -> void:
	checks += 1
	assert(value,message)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var scene = load("res://scenes/night_bus.tscn")
	var a = scene.instantiate()
	var b = scene.instantiate()
	var clock_scene = load("res://scenes/evening_clock.tscn")
	var clock = clock_scene.instantiate()
	var other_clock = clock_scene.instantiate()
	for node in [a,b,clock,other_clock]: root.add_child(node)
	a.arrived.connect(func(): arrivals += 1)
	check(a.schedule == b.schedule, "Immutable schedule intentionally shared")
	check(a.effective_wait_seconds() == 67 and a.countdown_seconds() == 75, "First arrival 67+8")
	check(a.schedule.repeat_wait_seconds == 25 and a.schedule.stop_seconds == 20 and a.schedule.departure_seconds == 8, "Repeat/stop/depart tuning")
	check(clock.elapsed == 0 and clock.time_text() == "23:40", "Fresh evening")
	await process_frame
	check(clock.elapsed == 0 and a.phase_time == 0, "Components never automatically advance")
	a.advance(12.25)
	clock.advance(12.25)
	check(a.countdown_seconds() == 63, "Remaining first arrival rounds upward")
	a.set_paused(true)
	check(a.skip_waiting() == -1 and a.phase_time == 12.25, "Paused skip invalid and inert")
	a.set_paused(false)
	var skipped: float = a.skip_waiting()
	check(skipped == 54.75, "Skip returns only exact remaining waiting seconds")
	clock.advance(skipped)
	check(clock.elapsed == 67 and clock.time_text() == "23:41", "Coordinator credits actual skip once")
	check(a.phase == "approaching" and a.phase_time == 0 and arrivals == 0, "Skip does not consume approach or emit arrival")
	check(not a.visual.visible and a.position.x == a.schedule.approach_x, "Skip enters hidden endpoint")
	check(a.skip_waiting() == -1, "Duplicate skip cannot double-credit")
	a.advance(8)
	clock.advance(8)
	check(a.phase == "stopped" and arrivals == 1 and clock.elapsed == 75, "First arrival at75 seconds")
	check(a.visual.door_open and a.visual.route_opacity == 1, "Arrival door and fade preserved")
	check(a.skip_waiting() == -1, "Stopped skip invalid")
	for cycle in range(3):
		a.advance(20)
		check(a.phase == "departing" and a.skip_waiting() == -1, "Departure skip invalid")
		a.advance(8)
		check(a.completed_cycles == cycle+1 and a.phase == "waiting", "Completed cycles owned by instance")
		check(a.effective_wait_seconds() == 25 and a.countdown_seconds() == 33, "Repeat arrival25+8")
		check(a.position.x == a.schedule.departure_x and not a.visual.visible, "Original invisible transition endpoint")
		check(a.skip_waiting() == 25, "Immediate repeat skip exact")
		check(a.position.x == a.schedule.approach_x and a.phase_time == 0 and not a.visual.visible, "Repeat skip safely relocates while hidden")
		a.advance(8)
	check(arrivals == 4, "Exactly one arrival per approach")
	check(b.completed_cycles == 0 and b.effective_wait_seconds() == 67 and b.phase_time == 0, "Second bus isolated")
	check(a.schedule.wait_seconds == 67 and a.schedule.repeat_wait_seconds == 25, "Shared schedule never mutated")
	check(other_clock.elapsed == 0 and other_clock.time_text() == "23:40", "Second clock isolated")
	a.hide()
	a.set_paused(true)
	a.reset()
	check(a.completed_cycles == 0 and a.effective_wait_seconds() == 67 and a.countdown_seconds() == 75, "Reset restores first cycle")
	check(not a.visible and not a.visual.visible and not a.paused, "Reset retains hidden-root ownership")
	a.advance(100)
	check(a.phase == "approaching" and a.phase_time == 0, "Regular advance retains single-transition semantics")
	clock.reset()
	clock.advance(-1)
	clock.advance(INF)
	clock.advance(NAN)
	check(clock.elapsed == 0, "Invalid clock deltas rejected")
	clock.advance(59.5)
	check(clock.time_text() == "23:40", "Clock minutes floor rather than round")
	clock.advance(.5)
	check(clock.time_text() == "23:41", "Minute boundary")
	clock.advance(1140)
	check(clock.time_text() == "00:00", "Midnight wraps without penalty")
	clock.advance(86400)
	check(clock.time_text() == "00:00" and clock.elapsed == 87600, "Elapsed continues across days")
	clock.reset()
	check(clock.elapsed == 0 and clock.time_text() == "23:40", "Clock reset")
	for node in [a,b,clock,other_clock]: node.queue_free()
	await process_frame
	print("RECOVERY CLOCK PASS: ",checks," checks")
	quit()
