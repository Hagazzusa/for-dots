extends SceneTree
var counts := {"arrival":0,"phase":0,"dispense":0,"sip":0,"fill":0}
func _initialize():
	call_deferred("run")
func count_arrival(): counts.arrival += 1
func count_phase(_phase): counts.phase += 1
func count_dispense(): counts.dispense += 1
func count_sip(): counts.sip += 1
func count_fill(_amount,_immediate): counts.fill += 1
func run():
	var bus_script = load("res://scripts/night_bus.gd")
	var drink_script = load("res://scripts/drink_session.gd")
	var a=bus_script.new()
	var b=bus_script.new()
	root.add_child(a)
	root.add_child(b)
	a.arrived.connect(count_arrival)
	a.phase_changed.connect(count_phase)
	a.advance(100)
	assert(a.phase=="approaching" and a.phase_time==0)
	assert(b.phase=="waiting")
	a.advance(8)
	assert(a.phase=="stopped" and a.position.x==0)
	assert(counts.arrival==1 and counts.phase==2)
	a.set_paused(true)
	a.advance(100)
	assert(a.phase=="stopped" and a.phase_time==0)
	a.set_paused(false)
	a.advance(20)
	a.advance(8)
	assert(a.phase=="waiting" and counts.arrival==1)
	a.reset()
	assert(a.position.x==-34 and counts.phase==4)
	var d=drink_script.new()
	var e=drink_script.new()
	root.add_child(d)
	root.add_child(e)
	d.dispense_started.connect(count_dispense)
	d.sip_started.connect(count_sip)
	d.fill_target_changed.connect(count_fill)
	assert(not d.request_action(false,false))
	assert(not d.request_action(true,true))
	assert(d.request_action(true,false))
	assert(not d.request_action(true,false))
	d.advance(1.2)
	assert(d.sips==3 and d.has_cup and e.sips==0 and not e.has_cup)
	assert(counts.dispense==1 and counts.fill==1)
	assert(d.request_action(false,false))
	assert(not d.request_action(false,false))
	d.advance(.4)
	assert(d.fill_pending)
	d.advance(.2)
	assert(not d.fill_pending and counts.fill==2)
	d.advance(.8)
	assert(d.request_action(false,false))
	d.advance(1.3)
	assert(d.request_action(false,false))
	d.advance(1.3)
	assert(d.sips==0 and d.has_cup and counts.sip==3)
	assert(d.request_action(true,false))
	d.reset()
	d.advance(20)
	assert(d.sips==0 and not d.has_cup and not d.fill_pending)
	assert(e.sips==0 and not e.has_cup)
	a.queue_free()
	b.queue_free()
	d.queue_free()
	e.queue_free()
	await process_frame
	print("COMPONENT TEST PASS: two-instance isolation, one-transition delta, pause/reset, signal counts, dispense/sip debounce, delayed fill, retained empty cup, reset during dispense")
	quit()
